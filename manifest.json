{
  "manifest_version": 3,
  "name": "Advanced YouTube Tweaker",
  "description": "Change speed, skip/mute ads, and bookmark parts of videos.",
  "version": "1.0",
  "permissions": ["scripting", "storage", "activeTab"],
  "host_permissions": ["*://www.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["*://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
